# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead (never commit real values).

# Calls the Claude API. Without it the chat returns a clear error.
ANTHROPIC_API_KEY=sk-ant-...

# Shared password for the access gate. The app fails closed without it:
# with no value set, nothing is served at all.
APP_ACCESS_PASSWORD=
