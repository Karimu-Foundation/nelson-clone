# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead (never commit real values).

# Calls the Claude API. Without it the chat returns a clear error.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if ANTHROPIC_API_KEY is an organisation-level key — one not
# created inside a workspace. Such a key is rejected with a 400 ("not scoped to
# a workspace") unless the request names one. Anthropic Console → Settings →
# Workspaces; the ID starts with `wrkspc_`. Leave empty for a workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=

# Shared password for the access gate. The app fails closed without it:
# with no value set, nothing is served at all.
APP_ACCESS_PASSWORD=

# Path to a checkout of the PRIVATE knowledge repository. When set, files in
# <PRIVATE_KB_DIR>/private-knowledge/ replace the public ones of the same name.
# Leave unset and the app runs on public-knowledge/ alone — which is what the
# production deployment currently does, until a build-time token is configured.
# Paths are relative to the repository root. Local example: PRIVATE_KB_DIR=../karimu-brain
PRIVATE_KB_DIR=
